# Production requires stable secrets, dashboard/device keys and GPIO mode "gpio".
VESTA_ENVIRONMENT=development

# Generate a long random value for stable control tokens across restarts.
VESTA_CONTROL_SIGNING_SECRET=replace-with-at-least-32-random-characters

# Optional authentication for the integration/test activation route.
# Physical GPIO activation is internal and does not use this key.
VESTA_DEVICE_API_KEY=replace-with-a-device-only-secret
# Required outside development/test for global dashboard reads and event streaming.
VESTA_DASHBOARD_API_KEY=replace-with-a-dashboard-read-secret

# Use "demo" for an offline scripted voice response or "elevenlabs" for live WebRTC.
VESTA_VOICE_MODE=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Safety timing. Use shorter values only for a controlled demonstration.
VESTA_CHECKIN_INTERVAL_SECONDS=60
VESTA_CHECKIN_RESPONSE_TIMEOUT_SECONDS=15
VESTA_CHECKIN_RETRY_DELAY_SECONDS=5
VESTA_CHECKIN_MAX_ATTEMPTS=2
VESTA_QUICK_CANCEL_SECONDS=5
VESTA_CLIENT_HEARTBEAT_TIMEOUT_SECONDS=45

# Raspberry Pi: set gpio. Laptop/CI: keep mock. Use disabled to turn the monitor off.
VESTA_GPIO_MODE=mock
VESTA_GPIO_PIN=17
VESTA_HOLD_SECONDS=5.0
VESTA_GPIO_DEBOUNCE_SECONDS=0.08
VESTA_GPIO_DEVICE_ID=vesta-rpi-01
VESTA_GPIO_LOCK_PATH=/tmp/vesta-gpio17.lock

# Comma-separated origins; never use * when session control tokens are in use.
VESTA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# Istoric în Tiger Data / TimescaleDB (implicit sigur: doar memorie).
# Setează "tiger" numai împreună cu TIMESCALE_SERVICE_URL valid.
VESTA_PERSISTENCE=memory
# TIMESCALE_SERVICE_URL se citește din mediu sau din .env-ul de la rădăcina proiectului.
TIMESCALE_SERVICE_URL=
# Contactele de încredere care primesc notificarea demonstrativă (separate prin virgulă).
VESTA_TRUSTED_CONTACT_IDS=demo-contact

# Telefonul se asociază cu codul tipărit pe dispozitiv (QR). Gol în dezvoltare = generat și afișat în log.
VESTA_DEVICE_PAIRING_CODE=
# Telefoane asociate, contacte de urgență, invitații, abonamente și chei push (persistă la restart).
VESTA_STATE_DIR=.state
VESTA_PUBLIC_URL=
VESTA_MAX_PAIRED_PHONES=5
VESTA_CONTACT_INVITE_TTL_SECONDS=86400
VESTA_COMPANION_TOKEN_TTL_SECONDS=2592000
VESTA_CONTACT_TOKEN_TTL_SECONDS=2592000
VESTA_GPS_STALE_SECONDS=60
VESTA_VAPID_SUBJECT=mailto:vesta@example.invalid
# Aplicația web compilată (frontend/dist) servită de backend: o singură adresă pentru telefon.
VESTA_FRONTEND_DIST=
# Citirea alimentării Raspberry Pi (doar cu VESTA_GPIO_MODE=gpio).
VESTA_POWER_POLL_SECONDS=30
