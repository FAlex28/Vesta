# Vesta on Raspberry Pi: /etc/vesta/vesta.env (chmod 600, owned by root).
# install.sh fills the three secrets below with random values on first install.

# --- Mode -------------------------------------------------------------------------------
# "production" refuses to start without the secrets and without real GPIO.
VESTA_ENVIRONMENT=production
VESTA_GPIO_MODE=gpio
VESTA_GPIO_PIN=17
VESTA_HOLD_SECONDS=5.0
VESTA_GPIO_DEBOUNCE_SECONDS=0.08
VESTA_GPIO_DEVICE_ID=vesta-rpi-01
VESTA_GPIO_LOCK_PATH=/run/vesta/gpio17.lock

# --- Secrets (never commit, never put in a URL) ------------------------------------------
VESTA_CONTROL_SIGNING_SECRET=__GENERATED__
VESTA_DASHBOARD_API_KEY=__GENERATED__
VESTA_DEVICE_API_KEY=__GENERATED__

# --- Phone pairing and emergency contacts ------------------------------------------------
# Printed on the device as a QR code (show-pairing-qr.sh). Rotate with rotate-pairing-code.sh.
VESTA_DEVICE_PAIRING_CODE=__GENERATED_CODE__
# Paired phones, contacts, invites, push subscriptions and push keys survive restarts here.
VESTA_STATE_DIR=/var/lib/vesta
# Stable public HTTPS address of this Vesta (QR code, SMS invites, push). See README step 8.
VESTA_PUBLIC_URL=
VESTA_MAX_PAIRED_PHONES=5
VESTA_CONTACT_INVITE_TTL_SECONDS=86400
VESTA_COMPANION_TOKEN_TTL_SECONDS=2592000
VESTA_CONTACT_TOKEN_TTL_SECONDS=2592000
# Contact address required by Web Push services (any mailbox of the team).
VESTA_VAPID_SUBJECT=mailto:vesta@example.invalid

# --- Web app ------------------------------------------------------------------------------
# The backend serves the built web app, so phone, dashboard and contact use one address.
VESTA_FRONTEND_DIST=__REPO__/frontend/dist
# Pages served by this backend are always allowed. Add other origins only if you serve
# the web app from somewhere else (e.g. a laptop running `npm run dev`).
VESTA_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Voice ----------------------------------------------------------------------------
# "elevenlabs" needs the two values below; "demo" shows scripted text without audio.
VESTA_VOICE_MODE=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# --- Safety timing (demo values; not validated safety standards) -----------------------
VESTA_CHECKIN_INTERVAL_SECONDS=60
VESTA_CHECKIN_RESPONSE_TIMEOUT_SECONDS=15
VESTA_CHECKIN_RETRY_DELAY_SECONDS=5
VESTA_CHECKIN_MAX_ATTEMPTS=2
VESTA_QUICK_CANCEL_SECONDS=5
VESTA_CLIENT_HEARTBEAT_TIMEOUT_SECONDS=45

# --- Session control token ------------------------------------------------------------
VESTA_CONTROL_TOKEN_TTL_SECONDS=14400

# --- History in Tiger Data (optional) ------------------------------------------------
# "memory" works offline. "tiger" also writes the timeline to TimescaleDB.
VESTA_PERSISTENCE=memory
TIMESCALE_SERVICE_URL=
VESTA_TRUSTED_CONTACT_IDS=demo-contact

# --- Power ----------------------------------------------------------------------------
VESTA_POWER_POLL_SECONDS=30
